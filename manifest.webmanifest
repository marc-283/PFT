  "display": "standalone",
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#000000",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Start workout", "short_name": "Workout", "url": "./#start", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Add meal", "short_name": "Meal", "url": "./#meal", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Calisthenics", "short_name": "Cali", "url": "./#cali", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Log a run", "short_name": "Run", "url": "./#run", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
